# Copy this file to .env and fill in your values:
#   Windows:      Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Any OpenAI-compatible endpoint works, e.g.:
#   OpenAI   : OPENAI_BASE_URL=https://api.openai.com/v1        MODEL=gpt-5.5
#   DeepSeek : OPENAI_BASE_URL=https://api.deepseek.com/v1      MODEL=deepseek-chat
#   Qwen     : OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-plus
#   Ollama   : OPENAI_BASE_URL=http://localhost:11434/v1        MODEL=qwen2.5:7b  (any API_KEY value works)

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.5

# MCP server launch command (space-separated). Defaults to this repo's mock server.
# To switch to a real cluster (requires Node.js and a working kubeconfig), e.g.:
# MCP_SERVER_COMMAND=npx -y mcp-server-kubernetes
MCP_SERVER_COMMAND=

# Maximum number of agent loop steps (guards against infinite loops)
MAX_STEPS=10

# Log level for agent.py / mcp_client.py (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
